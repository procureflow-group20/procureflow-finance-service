# Local development only. Copy to .env (never commit .env).
PORT=3003
SERVICE_NAME=finance-service
DB_SECRET_ID=procureflow/finance/db
JWT_SECRET_ID=procureflow/jwt
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
EVENT_BUS=procureflow-events
ALLOWED_ORIGINS=http://localhost:8080
AUDIT_TABLE=finance-audit-log
# local only: accepts forwarded events at POST /_local/events (never active inside Lambda)
LOCAL_EVENTS=1
